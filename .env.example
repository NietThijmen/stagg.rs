NODE_ENV=development

# PostgreSQL (used by Prisma)
# Matches the docker-compose.yml postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/staggers?schema=public

# ClickHouse
# Matches the docker-compose.yml clickhouse service.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=otel

# OpenTelemetry
OTEL_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=staggers-dashboard

# WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_COOKIE_PASSWORD=CHANGE_ME_32_CHAR_PASSWORD

# Kubernetes
# For local docker-compose dev, point KUBECONFIG at the file generated by k3s:
# KUBECONFIG=/Users/thijmenrierink/code/stagg.rs/.kubeconfig/kubeconfig.yaml
# Leave empty when running inside Kubernetes (in-cluster config).
KUBECONFIG=
K8S_NAMESPACE=customer-workloads
K8S_EDGE_NAMESPACE=edge-system

# Platform
PLATFORM_DOMAIN=saas.example
SGTM_IMAGE=gcr.io/cloud-tagging-10302018/gtm-cloud-image:stable

# Server port for dashboard
PORT=3000
