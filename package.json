{
  "name": "staggers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "dev:apps": "concurrently -k -n dashboard,api,reconciler,worker -c cyan,green,magenta,yellow \"pnpm --filter @staggers/dashboard dev\" \"pnpm --filter @staggers/api dev\" \"pnpm --filter @staggers/reconciler dev\" \"pnpm --filter @staggers/worker dev\"",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "pnpm --filter @staggers/dashboard dev",
    "api:dev": "pnpm --filter @staggers/api dev",
    "cli:dev": "pnpm --filter @staggers/cli dev",
    "openapi": "pnpm --filter @staggers/api openapi",
    "db:generate": "pnpm --filter @staggers/db generate",
    "db:migrate": "pnpm --filter @staggers/db migrate",
    "db:studio": "pnpm --filter @staggers/db studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
